{
  "name": "company-a-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src test e2e *.ts *.json",
    "format:check": "prettier --check src test e2e *.ts *.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
